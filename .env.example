# Copy this file to .env and fill in the values.

# --- Discord --------------------------------------------------------------- #
# Discord Application -> Bot -> Token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Target Discord channel for proactive alerts (right-click a channel -> Copy
# Channel ID, requires Developer Mode enabled in Discord's settings)
DISCORD_CHANNEL_ID=

# Server (guild) ID to register slash commands in (right-click the server
# icon -> Copy Server ID). Optional: leave empty to disable slash commands.
DISCORD_GUILD_ID=

# --- The Pi to watch (reached over SSH, typically across the tailnet) ------- #
# Tailscale hostname or IP of the Pi (recommended: its stable Tailscale name).
PI_SSH_HOST=
PI_SSH_PORT=22
PI_SSH_USER=pi
# Path INSIDE the container to the private deploy key (mounted by
# docker-compose.yml). Alternatively inline the key in PI_SSH_KEY.
PI_SSH_KEY_PATH=/keys/pi_id_ed25519
# PI_SSH_KEY=

# Label shown in embeds and the bot's presence.
HOST_LABEL=raspberrypi

# --- Alerting -------------------------------------------------------------- #
# Seconds between background metric polls.
POLL_INTERVAL_SECONDS=60

# Consecutive failed SSH checks before the Pi is declared unreachable (debounces
# a brief blip or the Wi-Fi failover switchover).
UNREACHABLE_THRESHOLD=3

# Thresholds (percent, except temperature in °C): WARNING at the first,
# CRITICAL at the second.
CPU_WARN_PERCENT=80
CPU_CRIT_PERCENT=95
MEM_WARN_PERCENT=80
MEM_CRIT_PERCENT=92
DISK_WARN_PERCENT=80
DISK_CRIT_PERCENT=90
TEMP_WARN_C=70
TEMP_CRIT_C=80

# --- Installed-update reports ---------------------------------------------- #
# Post an embed listing what unattended-upgrades installed on the Pi (package
# names and old -> new versions), read back from /var/log/apt/history.log.
# Set to 0 to turn the reports off.
REPORT_INSTALLED_UPDATES=1

# unattended-upgrades installs in several small dpkg steps. A run is only
# reported once its apt history has been quiet for this long, so one nightly
# run produces one embed instead of one per batch.
INSTALLED_UPDATES_SETTLE_SECONDS=180

# Where the bot remembers how far it has already reported. Backed by a Docker
# volume (see docker-compose.yml); if the path isn't writable the bot logs a
# warning and keeps running with in-memory state.
STATE_PATH=/var/lib/pi-monitoring/state.json
